{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the welcome and editor windows may do: Blocksy's own commands, folder/file pickers, opening links or folders in the OS, and the custom titlebar (drag, minimise, maximise, close).",
  "windows": [
    "welcome",
    "editor"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:event:default",
    "core:webview:allow-set-webview-zoom"
  ]
}
