{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blocksy",
  "version": "0.2.0",
  "identifier": "dev.blocksy.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blocksy",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "backgroundColor": "#ffffff",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "shortDescription": "Make Minecraft mods with nodes, visual editors and live docs"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCQzc1QUVGQTVBRDNGQ0IKUldUTFA2Mmw3MXJIcXdrR2dPa2ZEaGJMVHM4bDlheWg3WWEwN3o1NmFETDhGMlVVSG8wdlJDMGMK",
      "endpoints": [
        "https://github.com/simplyyliam/blocksy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
