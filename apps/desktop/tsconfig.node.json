{
  // vite.config.ts runs in Node, not the browser, so it gets Node types.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["vite.config.ts"]
}
