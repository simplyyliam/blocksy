{
  // Composite = other projects can reference this one; declarations go to dist/.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    // Tests hash binary files with node:crypto.
    "types": ["node"],
    // Tests import element packages, whose editor panels are React components.
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src"],
  // Workspace packages this one imports. tsc -b checks them first.
  "references": [
    { "path": "../core" },
    { "path": "../targets/fabric" },
    { "path": "../elements/block" },
    { "path": "../elements/creative-tab" }
  ]
}
