{
  // Composite = other projects can reference this one; declarations go to dist/.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    // Tests hash binary files with node:crypto.
    "types": ["node"]
  },
  "include": ["src"],
  // Workspace packages this one imports. tsc -b checks them first.
  "references": [{ "path": "../core" }, { "path": "../targets/fabric" }]
}
